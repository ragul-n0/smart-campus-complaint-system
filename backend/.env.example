# ==============================================================================
# Smart Campus Complaint & Issue Management System - Backend Environment Config
# ==============================================================================

PROJECT_NAME="Smart Campus Complaint System"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Database Configuration:
# Defaults to local SQLite database (stored as campus_complaints.db in backend folder)
DATABASE_URL="sqlite:///./campus_complaints.db"

# To switch to PostgreSQL later, comment out SQLite and uncomment the line below:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/campus_complaints_db"

# Allowed CORS Origins (Frontend URLs)
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
